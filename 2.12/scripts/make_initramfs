  REQMODULES="
                kernel/drivers/block/loop*
                kernel/drivers/cdrom
                kernel/drivers/scsi/sr_mod*
                kernel/drivers/ata
                kernel/drivers/usb/host
                kernel/drivers/fs/isofs
                kernel/drivers/fs/nls
                kernel/drivers/usb/storage
                kernel/fs/overlayfs 
                kernel/drivers/net/ethernet/intel/e1000
                "

	for mod in $REQMODULES; do
    if [ "$KERNEL" = "KERNEL3" ]
    then
		  FTGT="$FTGT /lib/modules/$(uname -r)/$mod"
    else
		  FTGT="$FTGT $KERNEL_MODULES_PATH/lib/modules/$KERNEL3/$mod"
    fi   
	done
  [ "$DIBAB_VERBOSE_BUILD" = "YES" ] && echo "KENEL:$KENEL find in $FTGT" && sleep 2
	for modules in $(find $FTGT -type f -name "*.ko*" 2> /dev/null); do
		modules=$(echo ${modules%*.ko*})
    echo -n "$module " && [ "$DIBAB_VERBOSE_BUILD" = "YES" ] && sleep 1
    if [ "$KERNEL" = "KERNEL3" ]
    then
		  INITDIR=$HOME/ydfs/tmp/initramfs-$ARCH/ KERNEL=$(uname -r) add_module ${modules##*/}
		  [ "$DIBAB_VERBOSE_BUILD" = "YES" ] && echo INITDIR=$HOME/ydfs/tmp/initramfs-$ARCH/ KERNEL=$(uname -r) add_module ${modules##*/}
    else
		  INITDIR=$HOME/ydfs/tmp/initramfs-$ARCH/ KERNEL=$KERNEL add_module ${modules##*/}
		  [ "$DIBAB_VERBOSE_BUILD" = "YES" ] && echo INITDIR=$HOME/ydfs/tmp/initramfs-$ARCH/ KERNEL=$KERNEL add_module ${modules##*/}
    fi
	done

  cp $HOME_DIBAB/dev-initramfs.cpio $HOME/ydfs/build-$ARCH/initramfs
