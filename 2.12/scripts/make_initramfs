 echo "Custom init-newroot"

cat > $HOME/ydfs/tmp/initramfs-$ARCH/init-newroot << "EOF"
PATH=/busybox/bin/:/busybox/sbin/
mkdir /rootfs
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs none /dev"  >> $HOME/ydfs/tmp/initramfs-$ARCH/init-newroot
mkdir /dev/pts"  >> $HOME/ydfs/tmp/initramfs-$ARCH/init-newroot
mount devpts /dev/pts -t devpts"  >> $HOME/ydfs/tmp/initramfs-$ARCH/init-newroot
mount -t tmpfs none /rootfs -o rw,noatime,mode=755
mkdir /rootfs/sys
mkdir /rootfs/proc
mkdir /rootfs/dev
mount -n -o move /sys /rootfs/sys
mount -n -o move /proc /rootfs/proc
mount -n -o move /dev /rootfs/dev
cp -a /busybox /rootfs/
cp -a /fix /rootfs/
cp -a /etc /rootfs/
cp -a /share /rootfs/
cp -a /ydfs /rootfs/
cp -a /lib /rootfs/
cp /ydfs-* /rootfs/
echo Switch YDFS root ..
exec /busybox/sbin/switch_root /rootfs /busybox/sbin/init </dev/console >dev/console 2>&1 
EOF
chmod +x $HOME/ydfs/tmp/initramfs-$ARCH/init-newroot

ln -sf /busybox/sbin/init  $HOME/ydfs/tmp/initramfs-$ARCH/

ROOTFS=/$HOME/ydfs/tmp/initramfs-$ARCH/
