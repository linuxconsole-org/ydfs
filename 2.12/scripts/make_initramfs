#From ydfs3 branch : mkinitramfs/hook/modules.hook

msgwarn() {
        [ $QUIET ] && return
        echo "WARNING: $*"
}

add_file() {
        [ "$1" ] || return

        src=$1

        if [ "$(echo $src | head -c1)" != "/" ]; then
                msgwarn "absolute source path needed: $src"
                return
        fi

        if [ ! -f "$src" ]; then
                msgwarn "file not found: $src"
                return
        fi

        if [ "$(echo $dest | head -c1)" = "/" ]; then
                msgwarn "destination path must without leading '/': $dest"
                return
        fi
        
        if [ -z "$2" ]; then
                dest=$(echo $src | sed 's,^/,,')
        else    
                dest="$2"
        fi
        
        mode=${3:-$(stat -c %a "$src")}
        if [ -z "$mode" ]; then
                msgwarn "failed get file mode: $src"
                return
        fi
        LIBMODULE=$INITDIR/lib/modules/$KERNEL/ 
        install -Dm$mode $src $LIBMODULE/$dest
        [ "$DIBAB_VERBOSE_BUILD" = "YES" ] && echo "$src -> $LIBMODULE/$dest"

        # Busybox modprobe does not support zst
        ARCHIVEZSTD=""
	      echo $dest | grep zst && ARCHIVEZSTD="OK"
        if [ "$ARCHIVEZSTD" = "OK" ]
        then
          unzstd $LIBMODULE/$dest 1>/dev/null 2>/dev/null
          NEW=$(echo $LIBMODULE/$dest | sed 's/\.zst//') 
          #echo mv $NEW $LIBMODULE/$dest # && sleep 1
          mv $NEW $LIBMODULE/$dest
        fi

        unset src dest mode
}


add_module() {
        # echo modinfo -b $KERNEL_MODULES_PATH -k $KERNEL $1 
        if modinfo -b $KERNEL_MODULES_PATH -k $KERNEL $1 >/dev/null 2>&1; then
                modname=$(modinfo -b $KERNEL_MODULES_PATH -k $KERNEL -F name $1 | cut -d ' ' -f1 | head -n1)
                [ "$modname" = "name:" ] && return 0
                # echo "modinfo -b $KERNEL_MODULES_PATH -k $KERNEL -F filename $1 "
                modpath=$(modinfo -b $KERNEL_MODULES_PATH -k $KERNEL -F filename $1 | cut -d ' ' -f1 | head -n1)
                [ "$modpath" = "name:" ] && return 0
        else
                echo "missing module: $1" && exit 2
                return
        fi
        if [ -f $INITDIR/lib/modules/$KERNEL/kernel/${modpath##*/} ]; then
                return
        fi
        DEST=$(echo $modpath | sed -e "s@$KERNEL_MODULES_PATH@@" | sed -e "s@/lib/modules/$KERNEL/@@")

        #echo "DIBAB_VERBOSE_BUILD : $DIBAB_VERBOSE_BUILD" && sleep 5
        # Only works for drivers on /lib/modules/KVER/
        #add_file "$modpath" lib/modules/$KERNEL/kernel/${modpath##*/}
        [ "$DIBAB_VERBOSE_BUILD" = "YES" ] && echo add_file "$modpath" $DEST && sleep 1
        add_file "$modpath" $DEST
        modinfo -b $KERNEL_MODULES_PATH -F firmware -k $KERNEL $modname | while read -r line; do
                if [ ! -f /lib/firmware/$line ]; then
                        msgwarn "missing firmware for $modname: $line"
                else
                        add_file /lib/firmware/$line
                fi
        done
        for i in $(modinfo -b $KERNEL_MODULES_PATH -F depends -k $KERNEL $modname | tr ',' ' '); do
                echo "$modname needs $i"
                add_module $i
        done
        unset modname modpath
}


