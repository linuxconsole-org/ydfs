ls /media |while read media
do
  if [ -e /media/$media/fixusb ]
  then
     ls /media/$media/fixusb |while read file
     do
       echo /media/$media/fixusb/$file
       cat /media/$media/fixusb/$file
       sleep 1
       bash /media/$media/fixusb/$file
     done
  fi
done

if [ -e /disk/fixusb ]
then
   ls /disk/fixusb |while read file
   do
     echo /disk/fixusb/$file
     cat /disk/fixusb/$file
     sleep 1
     bash /disk/fixusb/$file
   done
fi
